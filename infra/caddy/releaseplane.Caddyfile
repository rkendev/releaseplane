# Reverse-proxy vhosts for the public read-only demo (ADR 0009).
#
# This is a fragment, not a whole Caddyfile. Append it to the host's
# /etc/caddy/Caddyfile, substituting the real hostname for <demo-host>. Use the
# procedure in the "Reverse proxy" section of docs/RUNBOOK.md, which validates a
# candidate before writing the live file; on a host that fronts other projects,
# an unvalidated write persists a broken config that takes them all down at the
# next start.
#
# The delimiter comments make the block findable and removable by a later edit
# without disturbing whatever else the host serves.
#
# Caddy obtains and renews the certificates itself, so there is no certbot step.
# No secrets belong in this file.
#
# Both upstreams are on 127.0.0.1 because the demo overlay binds every service to
# loopback. That is the load-bearing part: the proxy is the only way in, and it
# reaches only these two ports. Nothing here routes to the control plane, the
# gateway, Postgres, MinIO, Prometheus, or the collector, so no public request can
# write state or cause a provider call.
#
# Two hostnames rather than one host with a /traces path: Jaeger needs
# QUERY_BASE_PATH set to serve its UI under a subpath, and a second vhost costs
# nothing on a host that already issues certificates per name.
#
# Note what is deliberately absent. There is no blanket method allowlist, tempting
# as it looks for a read-only surface: Grafana's own frontend POSTs to
# /api/ds/query to render a panel, so rejecting non-GET would break the demo it
# was protecting. Read-only is enforced in Grafana instead (anonymous Viewer, both
# authentication paths off), with one path-level exception below, and
# docs/SECURITY.md records the probes that confirm it. There is also no rate
# limit, which standard Caddy does not carry; the residual risk is compute on an
# idle box rather than data exposure, which is why the access log below matters.

# >>> releaseplane demo (managed) >>>
releaseplane.<demo-host> {
	encode gzip

	# Grafana treats an anonymous visitor as a signed-in user, so every endpoint
	# gated on "signed in" rather than on a role is open to the internet here. Four
	# of them were reachable and are refused, each measured against the pinned
	# image rather than assumed:
	#
	#   /api/short-urls      POST returned 200 and wrote a row that /goto/<uid>
	#                        resolved. A small write, but unbounded and
	#                        uncredentialed. Both the bare and trailing-slash forms
	#                        answered, and Caddy's path matcher is exact, so both
	#                        are listed. A demo needs no share-link button.
	#   /api/gnet/*          Grafana's proxy to grafana.com. GET returned 200, which
	#                        means a visitor can make this box originate outbound
	#                        requests. Nothing here installs plugins or browses the
	#                        dashboard gallery.
	#   /api/frontend-metrics  POST returned 200: anonymous data into the instance.
	#   /api/live/publish    POST reached body validation rather than an
	#                        authorization refusal. Nothing here publishes on a
	#                        live channel.
	#
	# Everything else Grafana serves is passed through, including the POST that
	# renders a panel and the /api/live/ws the frontend opens.
	@refused path /api/short-urls /api/short-urls/* /api/gnet/* /api/frontend-metrics /api/live/publish
	respond @refused "read-only demo" 405

	# Without this the public surface produces no access log at all: Caddy v2 logs
	# per site and sets no global default, so the accepted compute-exhaustion risk
	# would be neither observable nor attributable. stderr rather than a file
	# because systemd captures it into the journal alongside the rest of Caddy's
	# output, which needs no directory, no permissions, and no rotation config on
	# whatever host this lands on.
	log {
		output stderr
	}

	header {
		# The site is HTTPS-only and the certificate renews automatically.
		Strict-Transport-Security "max-age=31536000"
	}

	reverse_proxy 127.0.0.1:3000 {
		# Grafana's auth-proxy mode is not enabled, so this header is not trusted
		# today. Stripping it means a later operator turning that mode on does not
		# hand authentication to anyone who can set a header.
		header_up -X-WEBAUTH-USER
		header_up -X-Grafana-User
	}
}

releaseplane-traces.<demo-host> {
	encode gzip

	log {
		output stderr
	}

	header {
		Strict-Transport-Security "max-age=31536000"
	}

	reverse_proxy 127.0.0.1:16686
}
# <<< releaseplane demo (managed) <<<
