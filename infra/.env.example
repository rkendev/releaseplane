# ReleasePlane local dev secrets.
#
# Copy to .env (gitignored) and fill in. `make secrets` (Phase 1) writes each
# value into infra/secrets/<name>. Never commit .env or the files in infra/secrets/.

# --- Local services -----------------------------------------------------------
POSTGRES_PASSWORD=changeme-local-dev
MINIO_ROOT_PASSWORD=changeme-local-dev
GRAFANA_ADMIN_PASSWORD=changeme-local-dev

# --- Provider keys ------------------------------------------------------------
# v1 provider (Claude).
CLAUDE_API_KEY=

# Phase 5 provider placeholder. Uncomment when the second provider lands.
# Pre-reserved here so the secret-loading path does not need a retrofit.
# OPENAI_API_KEY=
