# ReleasePlane local dev secrets.
#
# Copy to .env (gitignored) and fill in. `make secrets` (Phase 1) writes each
# value into infra/secrets/<name>. Never commit .env or the files in infra/secrets/.

# --- Local services -----------------------------------------------------------
POSTGRES_PASSWORD=changeme-local-dev
MINIO_ROOT_PASSWORD=changeme-local-dev
GRAFANA_ADMIN_PASSWORD=changeme-local-dev

# --- Provider keys ------------------------------------------------------------
# v1 provider (Claude).
CLAUDE_API_KEY=

# Second provider (OpenAI), added in Phase 5. Leave empty to run on Dummy/Claude
# only: an empty value means `make secrets` writes an empty file and the gateway
# registry omits the OpenAI adapter (clean skip).
OPENAI_API_KEY=

# --- Host port layout (read by docker-compose.demo.yml) -----------------------
# These belong in infra/.env, not the workspace-root .env: compose reads the env
# file from the project directory, which is infra/ when the first -f names a file
# there. `make secrets` reads the root .env; the two files are separate.
#
# Only needed on a host that remaps ports away from the base compose defaults
# (shown below). Compose loads docker-compose.override.yml automatically only when
# no -f is given at all; the demo bring-up names its files explicitly, so the
# override file is not read and these variables are how a host states its layout.
#PG_HOST_PORT=5432
#CONTROL_PLANE_HOST_PORT=8001
#GATEWAY_HOST_PORT=8002
#MINIO_HOST_PORT=9000
#MINIO_CONSOLE_HOST_PORT=9001

# Public origin the reverse proxy serves Grafana on, used for its redirect and
# share links. Only meaningful with the demo overlay.
#DEMO_ROOT_URL=https://releaseplane.example.org/

# Gateway provider override. Unset means "dummy", which is the zero-spend default
# and what the demo serves on. The only reason to set it here is the population run
# (docs/RUNBOOK.md), and the only value that works for that is the empty one:
#
#   GATEWAY_PROVIDER=          follow the model config, so routing picks the provider
#
# Any non-empty value wins over the routed config for every request, so setting it
# to claude would spend the full estimate and still serve the gpt-4o-mini invoke on
# claude. Remove the line again when the run is done.
#GATEWAY_PROVIDER=
