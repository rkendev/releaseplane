{
  "uid": "releaseplane-eval",
  "title": "ReleasePlane Eval",
  "tags": ["releaseplane", "eval"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 4,
      "type": "text",
      "title": "What this shows",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "A release cannot be promoted unless its latest eval run clears every gating threshold. **Tier 1** needs 100% on all three metrics. **Tier 2** needs 100% schema validity, 100% arithmetic consistency, and at least 80% checksum match. Tier 3 is monitored, never gating (`docs/EVALUATION.md`).\n\nThe panel below plots the measured rate per release, tier, and metric. The dashed line marks 100%, which is the threshold for every gating metric except Tier-2 checksum match, where 80% clears. The v1 prompt sits at 90% on Tier-2 schema validity and arithmetic consistency, under the line on two gating metrics, because it read a volume discount as a negative line item. The v2 prompt clears every threshold."
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Eval pass rate per release, against the gate threshold",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 18, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "control_plane_eval_pass_rate", "legendFormat": "{{release_id}} t{{tier}} {{metric}}" } ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total eval runs",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 4 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(control_plane_eval_runs_total)", "legendFormat": "runs" } ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Eval runs over time (by status)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (status) (control_plane_eval_runs_total)", "legendFormat": "{{status}}" } ]
    }
  ]
}
